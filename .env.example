POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://stocks:change-me@postgres:5432/stocks
# Compose deployment boundary. The default binds Web to all interfaces for
# access from the Owner's devices; keep it behind the host's HTTPS or private
# reverse proxy. API, Worker and PostgreSQL publish no host ports.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
# Target this explicitly when deploying to an ARM server. The default keeps
# local testing on the amd64 platform of the specified test server.
TARGET_PLATFORM=linux/amd64
# Only used by isolated test stacks. Leave the default for the production stack.
POSTGRES_VOLUME_NAME=stocks-pgdata
S3_ENDPOINT_URL=https://private-s3-host
S3_BUCKET=stocks
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 对象存储凭据必须成对配置；S3_BUCKET 不得为空。
PARSE_CHUNK_SIZE=1200
PARSE_CHUNK_OVERLAP=150
# Maximum Task Runs one Worker executes at the same time. 2 lets a scheduled
# collection Run start while a long research Run is still in flight; 1 keeps
# them strictly serialized. Bounded to 1..16.
WORKER_MAX_CONCURRENT_RUNS=2
# Maximum Document processing stages one Worker executes at the same time. The
# document slots are separate from the Run slots so a parse/index backlog never
# starves scheduled collection or research. Bounded to 1..16.
WORKER_MAX_CONCURRENT_DOCUMENTS=1
MODEL_API_BASE_URL=https://model.example/v1
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL_NAME=text-embedding-3-small
# Single-Owner HTTP access. Use a long unique password and a separate random
# signing secret of at least 32 characters; generate each with `openssl rand`.
# Keep the cookie Secure when the browser accesses HTTPS, including through a
# reverse proxy. The session TTL is bounded to 5 minutes..7 days.
OWNER_PASSWORD=
OWNER_SESSION_SECRET=
OWNER_SESSION_TTL_SECONDS=43200
OWNER_COOKIE_SECURE=false
# Characters of the current parse batch one classification call may read. The
# Decision Model never receives an unbounded full text. Bounded to 200..40000.
CLASSIFICATION_MAX_CHARACTERS=6000
# Characters of the current parse batch one Fact extraction call may read. The
# remaining text stays in the original Document and its Chunks. Bounded to
# 200..80000.
FACT_EXTRACTION_MAX_CHARACTERS=12000
